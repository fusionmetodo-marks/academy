{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the CFA Financial Academy platform.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier of the user (from Firebase Auth)."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the user."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "producer", "student"],
          "description": "The role of the user."
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "inactive", "pending"],
          "description": "Whether the user has an active subscription to access content."
        },
        "enrolledCourses": {
          "type": "array",
          "description": "Array of course IDs the user is enrolled in."
        },
        "completedLessons": {
          "type": "array",
          "description": "An array of lesson IDs that the student has completed."
        },
        "lessonViews": {
          "type": "object",
          "description": "A map where keys are lesson IDs and values are count of times viewed by user."
        },
        "normalizedPhone": {
          "type": "string",
          "maxLength": 32,
          "description": "Digits-only normalized phone number for automatic contact linking."
        },
        "floatingChatAlertsEnabled": {
          "type": "boolean",
          "description": "Whether floating real-time chat alert popups are enabled for this user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user was created."
        }
      },
      "required": ["uid", "email", "role", "subscriptionStatus"]
    },
    "Course": {
      "title": "Course",
      "description": "A course offered on the CFA Academy platform.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "instructor": { "type": "string" }
      },
      "required": ["title", "price"]
    },
    "Module": {
      "title": "Module",
      "description": "A thematic module grouping lessons in a course.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "courseId": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "courseId"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "A specific class lesson belonging to a course.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "courseId": { "type": "string" },
        "moduleId": { "type": "string" },
        "videoUrl": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["title", "courseId"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A payment submission / receipt confirmation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "referenceNumber", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System collective or individual targeted user alert.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 64 },
        "scope": {
          "type": "string",
          "enum": ["individual", "collective", "admin"]
        },
        "title": { "type": "string", "maxLength": 300 },
        "message": { "type": "string", "maxLength": 2500 },
        "link": { "type": "string", "maxLength": 500 },
        "targetRole": {
          "type": "string",
          "enum": ["admin", "student", "producer", "all"]
        },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "targetEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "read": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "metadata": { "type": "object" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message"]
    },
    "NotificationState": {
      "title": "NotificationState",
      "description": "Per-user read and dismissed state for collective and individual notifications.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "notificationId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "dismissed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "notificationId", "read", "dismissed"]
    },
    "Settings": {
      "title": "Settings",
      "description": "System settings such as payout IBAN, KWIK, and Multicaixa references.",
      "type": "object",
      "properties": {
        "iban": { "type": "string" },
        "ibanActive": { "type": "boolean" },
        "bankName": { "type": "string" },
        "expressIban": { "type": "string" },
        "expressActive": { "type": "boolean" },
        "expressPhone": { "type": "string" },
        "expressName": { "type": "string" },
        "kwikPhone": { "type": "string" },
        "kwikActive": { "type": "boolean" },
        "kwikName": { "type": "string" },
        "multicaixaEntity": { "type": "string" },
        "multicaixaReference": { "type": "string" },
        "multicaixaActive": { "type": "boolean" },
        "supportWhatsApp": { "type": "string" },
        "platformName": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "FirebaseBillingSettings": {
      "title": "FirebaseBillingSettings",
      "description": "Team-synchronized Firebase Spark/Blaze billing tier, monthly budget thresholds, and console calibration offsets.",
      "type": "object",
      "properties": {
        "planTier": { "type": "string", "enum": ["spark", "blaze"] },
        "blazeUpgradedAtIso": { "type": "string", "format": "date-time" },
        "planUpdatedByEmail": { "type": "string", "format": "email" },
        "monthlyBudgetUsd": { "type": "number" },
        "budgetAlertThresholdPct": { "type": "number" },
        "monthlyReadUnitsOffset": { "type": "number" },
        "monthlyWriteUnitsOffset": { "type": "number" },
        "monthlyEgressGiB": { "type": "number" },
        "storedDataGiB": { "type": "number" },
        "dailyCycleKey": { "type": "string" },
        "dailyConsoleReadsOffset": { "type": "number" },
        "dailyConsoleWritesOffset": { "type": "number" },
        "updatedAtIso": { "type": "string", "format": "date-time" }
      }
    },
    "ChristmasBonusSettings": {
      "title": "ChristmasBonusSettings",
      "description": "Admin-editable configuration for the 7-day Christmas live trading bonus with Marks, including main room URL and per-day date, WAT time, session state, quick notice, and optional custom room URL.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "festiveTag": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "scheduled", "live", "ended"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "liveTimeWat": { "type": "string" },
        "liveRoomUrl": { "type": "string" },
        "accessNotes": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "days": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "LessonPlayback": {
      "title": "LessonPlayback",
      "description": "Records an individual video playback event initiated when a student clicks Play on a lesson.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 200 },
        "studentEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseTitle": { "type": "string", "maxLength": 250 },
        "moduleId": { "type": "string", "maxLength": 128 },
        "moduleTitle": { "type": "string", "maxLength": 250 },
        "lessonId": { "type": "string", "maxLength": 128 },
        "lessonTitle": { "type": "string", "maxLength": 250 },
        "playNumber": { "type": "number" },
        "createdAtMs": { "type": "number" },
        "playedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "studentName", "studentEmail", "courseId", "lessonId", "lessonTitle", "playNumber", "createdAtMs"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "1-on-1 private chat channel between an individual student or pre-registered contact and the administrator.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 200 },
        "studentEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "studentPhone": { "type": "string", "maxLength": 64 },
        "normalizedPhone": { "type": "string", "maxLength": 32 },
        "isPreRegistered": { "type": "boolean" },
        "linkedUserId": { "type": "string", "maxLength": 128 },
        "mergedIntoChatId": { "type": "string", "maxLength": 128 },
        "sourcePreChatId": { "type": "string", "maxLength": 128 },
        "lastMessage": { "type": "string", "maxLength": 2000 },
        "lastSenderRole": { "type": "string", "enum": ["admin", "student"] },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "unreadByAdmin": { "type": "number" },
        "unreadByStudent": { "type": "number" },
        "lastAdminBellAtMs": { "type": "number" },
        "lastStudentBellAtMs": { "type": "number" }
      },
      "required": ["studentId", "studentName", "lastMessage", "lastSenderRole", "lastSenderId", "lastMessageAtMs", "unreadByAdmin", "unreadByStudent"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "An individual text message inside a student-administrator 1-on-1 chat thread.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 200 },
        "senderRole": { "type": "string", "enum": ["admin", "student"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "contextLessonTitle": { "type": "string", "maxLength": 250 },
        "contextCourseTitle": { "type": "string", "maxLength": 250 },
        "contextCourseId": { "type": "string", "maxLength": 128 },
        "migratedFromChatId": { "type": "string", "maxLength": 128 },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "senderName", "senderRole", "text", "createdAtMs"]
    },
    "ChatClaim": {
      "title": "ChatClaim",
      "description": "Deterministic lookup index linking normalized email or phone keys to a pre-registered chat thread.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 128 },
        "matchKey": { "type": "string", "maxLength": 128 },
        "createdAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "matchKey", "createdAtMs"]
    },
    "LessonComment": {
      "title": "LessonComment",
      "description": "Persisted public discussion comment under a course lesson with author role.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string", "maxLength": 128 },
        "lessonId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 200 },
        "authorRole": { "type": "string", "enum": ["admin", "student"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "lessonId", "authorId", "authorName", "authorRole", "text", "createdAtMs"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles including their roles and subscription status."
    },
    "/users/{userId}/notificationStates/{notificationId}": {
      "schema": {
        "$ref": "#/entities/NotificationState"
      },
      "description": "Stores per-student read and dismissed states for notifications."
    },
    "/courses/{courseId}": {
      "schema": {
        "$ref": "#/entities/Course"
      },
      "description": "Stores course metadata and public catalog items."
    },
    "/modules/{moduleId}": {
      "schema": {
        "$ref": "#/entities/Module"
      },
      "description": "Stores course curriculum modules."
    },
    "/lessons/{lessonId}": {
      "schema": {
        "$ref": "#/entities/Lesson"
      },
      "description": "Stores video lessons accessible strictly to enrolled students."
    },
    "/lessonPlaybacks/{playbackId}": {
      "schema": {
        "$ref": "#/entities/LessonPlayback"
      },
      "description": "Stores chronological video playback events per student and lesson for administrative analytics."
    },
    "/lessonComments/{commentId}": {
      "schema": {
        "$ref": "#/entities/LessonComment"
      },
      "description": "Stores persisted lesson comments from students and administrators with direct chat links."
    },
    "/chats/{studentId}": {
      "schema": {
        "$ref": "#/entities/ChatThread"
      },
      "description": "Stores 1-on-1 chat metadata and unread counters between a student or pre-registered contact and the administrator."
    },
    "/chats/{studentId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Stores chronological text messages inside a student-administrator 1-on-1 chat thread."
    },
    "/chatClaims/{claimId}": {
      "schema": {
        "$ref": "#/entities/ChatClaim"
      },
      "description": "Deterministic index mapping normalized contact keys (email/phone) to pre-registered chat threads."
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "Stores payment receipts and status verifications."
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Stores private user and collective system notifications."
    },
    "/settings/{settingsId}": {
      "schema": {
        "$ref": "#/entities/Settings"
      },
      "description": "Stores system configurations such as payment methods."
    }
  }
}
